    "AlertDialogFooter": null,
    "AlertDialogHeader": null,
    "AlertDialogMedia": null,
    "CardFooter": null,
    "SelectGroup": null,
    "SheetFooter": null,
    "SheetHeader": null,
    "TableCaption": null,
    "TableCell": null,
    "TableHead": null
  },
  "overrides": {
    "Dialog": {
      "cardMode": "single",
      "viewport": "720x520"
    },
    "AlertDialog": {
      "cardMode": "single",
      "viewport": "720x420"
    },
    "Sheet": {
      "cardMode": "single",
      "viewport": "720x520"
    },
    "DropdownMenu": {
      "cardMode": "single",
      "viewport": "420x320"
    },
    "DataTable": {
      "cardMode": "column"
    },
    "Card": {
      "cardMode": "column"
    },
    "PageHeader": {
      "cardMode": "column"
    },
    "Progress": {
      "cardMode": "single",
      "primaryStory": "Setup"
    },
    "RecordList": {
      "cardMode": "single",
      "primaryStory": "Phone",
      "viewport": "390x520"
    }
  },
  "readmeHeader": ".design-sync/conventions.md"
}
