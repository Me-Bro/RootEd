  "shape": "package",
  "pkg": "rooted",
  "globalName": "RootEd",
  "buildCmd": "pnpm --filter rooted build:ui-lib && node .ds-sync/node_modules/typescript/bin/tsc -p apps/rooted/ui-lib/tsconfig.json && node apps/rooted/ui-lib/emit-types.mjs",
  "cssEntry": "dist-ui/rooted.css",
  "provider": {
    "component": "RootEdProvider"
  },
  "componentSrcMap": {
