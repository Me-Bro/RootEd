# Server
PORT=3001
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/rooted?replicaSet=rs0
# Request-monitoring DB (separate database, same cluster). Optional — defaults to
# MONGODB_URI with "_monitoring" appended to the db name if unset.
MONITORING_MONGODB_URI=

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Minio / S3
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=rooted

# Email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@rooted.app
EMAIL_PROVIDER=smtp
POSTMARK_API_TOKEN=

# Encryption (field-level, per-tenant DEK master key — 32 bytes hex)
MASTER_ENCRYPTION_KEY=change-me-32-byte-hex-master-key

# App
APP_DOMAIN=rooted.app
# Optional — treat <label>.APP_DOMAIN as the general-portal host (login without a
# tenant subdomain), same as the bare APP_DOMAIN. Leave unset unless the apex
# domain itself isn't reachable/desired for login (e.g. behind a tunnel).
PORTAL_SUBDOMAIN=

# CSRF
CSRF_SECRET=change-me-csrf-secret-min-32-chars

# Razorpay (billing)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Sentry (error tracking)
SENTRY_DSN=
