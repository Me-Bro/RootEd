PORT=3001
# Keep development so CORS allows all origins (web runs on localhost:5173)
NODE_ENV=development
APP_DOMAIN=localhost

# Separate test database — never use the same DB as development. Mongo lives
# outside this repo (see ~/Desktop/rooted-mongo-shared) with auth enabled;
# ask a teammate (or whoever ran the bootstrap) for the rooted_test_app password.
MONGODB_URI=mongodb://rooted_test_app:CHANGE_ME@127.0.0.1:27017/rooted_test?replicaSet=rs0&authSource=rooted_test

REDIS_URL=redis://:CHANGE_ME@localhost:6379

JWT_ACCESS_SECRET=test-access-secret-minimum-32-chars-ok
JWT_REFRESH_SECRET=test-refresh-secret-minimum-32-chars-ok
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=rooted_test_app
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET=rooted-test

EMAIL_FROM=test@rooted.local
EMAIL_PROVIDER=smtp

# 32-char hex key for field encryption
MASTER_ENCRYPTION_KEY=74657374-6d61737465722d6b65792d333262

CSRF_SECRET=test-csrf-secret-minimum-32-chars!!
