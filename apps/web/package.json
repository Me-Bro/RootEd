{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:e2e": "node node_modules/@playwright/test/cli.js test --project=e2e",
    "test:e2e:headed": "node node_modules/@playwright/test/cli.js test --project=e2e --headed",
    "test:e2e:ui": "node node_modules/@playwright/test/cli.js test --ui",
    "test:e2e:report": "node node_modules/@playwright/test/cli.js show-report",
    "test:axe": "node node_modules/@playwright/test/cli.js test --project=axe",
    "test:seed": "node tests/seed/seed.js",
    "test:seed:clean": "node tests/seed/seed.js --clean",
    "test:seed:docker": "docker compose -f ../../docker-compose.yml -f ../../docker-compose.test.yml exec api node src/scripts/seed-test-data.js",
    "test:snapshot:dump": "node --env-file=../api/.env.test tests/seed/snapshot.js dump",
    "test:snapshot:restore": "node --env-file=../api/.env.test tests/seed/snapshot.js restore"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@fontsource-variable/geist": "^5.2.8",
    "@sentry/react": "^10.53.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.100.10",
    "axios": "^1.16.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "i18next": "^26.2.0",
    "lucide-react": "^1.16.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.75.0",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^7.15.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.60.0",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/react": "^10.4.0",
    "@storybook/react-vite": "^10.4.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "axe-playwright": "^2.2.2",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.0.12"
  }
}
