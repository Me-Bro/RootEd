# API calls always go through the same-origin /__api proxy (vite in dev, nginx in
# the built image) — leave VITE_API_URL empty so the CSRF cookie stays first-party.
VITE_API_URL=

# Domain the API treats as its apex (matches apps/api APP_DOMAIN).
VITE_APP_DOMAIN=localtest.me

# Host the portal's server presents to the API. Defaults to VITE_APP_DOMAIN (the
# bare apex, which the API treats as the general-portal host). On the tunnel
# deployment set this to the existing portal host, e.g. rooted.ruralrootcloud.com.
PORTAL_API_HOST=

# Where registration, password reset, invites and account claim live (apps/web).
VITE_MAIN_APP_URL=http://localtest.me
