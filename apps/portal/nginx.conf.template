# The visitor's address as the proxy in front saw it (X-Real-IP), or this
# connection's own when nothing sits in front. Sent to the API as the only
# X-Forwarded-For entry so Express (trust proxy 1) rate-limits per visitor
# instead of treating every visitor as the proxy in front.
map $http_x_real_ip $client_ip {
  default $http_x_real_ip;
  ""      $remote_addr;
}

server {
  listen 80;
  root /usr/share/nginx/html;
  index index.html;

  # Same-origin API proxy, so the refresh and CSRF cookies stay first-party.
  #
  # Host is pinned to ${PORTAL_API_HOST}: the existing portal host of this
  # deployment (e.g. rooted.ruralrootcloud.com). The API treats that host as
  # "no tenant in the hostname" and takes the college from the access token's
  # claim, so the portal needs no tenant subdomain of its own and the API needs
  # no change.
  #
  # X-Forwarded-Host is blanked: Express trusts it, so a browser could otherwise
  # name any college by sending its own copy of the header.
  location /__api/ {
    proxy_pass http://api:3001/;
    proxy_http_version 1.1;
    proxy_set_header Host ${PORTAL_API_HOST};
    proxy_set_header X-Forwarded-Host "";
    proxy_set_header X-Real-IP $client_ip;
    proxy_set_header X-Forwarded-For $client_ip;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # SPA fallback
  location / {
    try_files $uri $uri/ /index.html;
  }

  # The service worker and manifest must always be revalidated: a year-long cache
  # on sw.js would pin every browser to the version it first installed.
  location = /sw.js {
    add_header Cache-Control "no-cache";
  }
  location = /manifest.webmanifest {
    add_header Cache-Control "no-cache";
  }

  # Cache static assets
  location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff2?)$ {
    expires 1y;
    add_header Cache-Control "public, immutable";
  }
}
